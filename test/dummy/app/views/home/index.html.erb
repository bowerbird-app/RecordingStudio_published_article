<% dummy_page_nav(title: "Published articles", back_url: root_path) %>

<div class="flex w-full flex-col gap-10">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Published articles",
    subtitle: "The same article list under a workspace, a folder, and a publication.",
    variant: :h1
  ) %>

  <%= render RecordingStudioPublishedArticle::Articles::IndexComponent.new(
    article_recordings: @workspace_articles,
    parent_recording: @workspace_recording,
    filters: {},
    title: "Studio workspace",
    subtitle: "Articles kept with the workspace.",
    title_variant: :h2,
    show_path: ->(recording) { recording_studio_published_article.article_path(recording) }
  ) %>

  <%= render RecordingStudioPublishedArticle::Articles::IndexComponent.new(
    article_recordings: @folder_articles,
    parent_recording: @folder_recording,
    filters: {},
    title: "Product Docs",
    subtitle: "Articles kept with the folder.",
    title_variant: :h2,
    show_path: ->(recording) { recording_studio_published_article.article_path(recording) }
  ) %>

  <%= render RecordingStudioPublishedArticle::Articles::IndexComponent.new(
    article_recordings: @publication_articles,
    parent_recording: @publication_recording,
    filters: {},
    title: "The Atlantic",
    subtitle: "Articles kept with the publication.",
    title_variant: :h2,
    show_path: ->(recording) { recording_studio_published_article.article_path(recording) }
  ) %>
</div>
