<% dummy_page_nav(title: "Config", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Config",
    subtitle: "Allowed parents for a published article. The default list is empty.",
    variant: :h1
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioPublishedArticle.configure do |config|
        config.article_parent_types = %w[Workspace Folder RecordingStudioPublications::Publication]
      end
    CODE
  ) %>
</div>
