<% dummy_page_nav(title: "Methods", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Public methods this addon exposes.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Record an article",
    subtitle: "Write through the parent."
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      root.record(
        RecordingStudioPublishedArticle::PublishedArticle,
        parent_recording: folder_recording
      ) do |article|
        article.title = "The Quiet Crop"
        article.url = "https://example.com/quiet-crop"
      end
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "List articles for a parent",
    subtitle: "RecordingStudioPublishedArticle::Queries::Collection.call"
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioPublishedArticle::Queries::Collection.call(
        parent_recording: parent_recording,
        filters: { year: 2024, q: "crop", attachment_kind: :pdf }
      )
    CODE
  ) %>
</div>
