<% recording_studio_page_nav(
  title: "Articles",
  page_nav_back_url: main_app.root_path,
  page_nav_back_label: "Home"
) %>

<%= render RecordingStudioPublishedArticle::Articles::IndexComponent.new(
  article_recordings: @article_recordings,
  parent_recording: @parent_recording,
  filters: @filters,
  view: @view,
  show_path: ->(recording) { article_path(recording) },
  cards_path: recording_articles_path(@parent_recording, **article_filter_query.merge(view: "cards")),
  table_path: recording_articles_path(@parent_recording, **article_filter_query.merge(view: "table")),
  filter_path: recording_articles_path(@parent_recording)
) %>
